# Smart Garden AI — Environment Variables
# Copy this file to .env and fill in your keys

# ── Weather ────────────────────────────────────────────────────
# Free at openweathermap.org → API Keys tab
OPENWEATHER_API_KEY=your_openweather_key_here

# ── Disease Detection: Model 1 (PRIMARY) ───────────────────────
# Kindwise crop.health — purpose-built crop disease AI
# 23 crops, 288 diseases/pests, treatment info included
# FREE 100 credits on signup (no card): admin.kindwise.com
# Without this key the app uses the free trial proxy (10 req/IP/day)
CROP_HEALTH_API_KEY=your_crop_health_key_here

# ── Disease Detection: Model 2 (FALLBACK) ──────────────────────
# HuggingFace — MobileNetV2 PlantVillage (38 classes)
# Free read token: huggingface.co/settings/tokens
# Without this key the HF model still works but with lower rate limits
HF_API_TOKEN=hf_your_token_here

# ── Server ─────────────────────────────────────────────────────
PORT=3000
