# Smart Garden AI — Environment Variables
# Copy this file to .env and fill in your keys

# OpenWeatherMap API Key (free at openweathermap.org)
OPENWEATHER_API_KEY=your_openweather_key_here

# Hugging Face API Token — FREE, no billing required
# 1. Sign up at huggingface.co
# 2. Go to huggingface.co/settings/tokens
# 3. New token → Name: smart-garden → Role: Read → Create
# 4. Paste the token below
# NOTE: Even without this token the model is publicly accessible
# but adding it gives you higher rate limits (priority queue)
HF_API_TOKEN=hf_your_token_here

# Server Port (Render sets this automatically)
PORT=3000
